# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# POLICY0_API_KEY: API key for authenticating requests to /api/* endpoints.
# Set this in production. Leave empty for development (no auth required).
POLICY0_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ===== NVIDIA Stack Migration Feature Flags =====
# Each flag toggles the NVIDIA-stack implementation of a pipeline phase.
# When unset/anything-but-'true', the original legacy path is used.
USE_COSMOS_VLM=false        # Phase 1: Cosmos Reasoner NIM for video analysis
USE_NIM_LLM=false           # Phase 2: NIM LLMs (Llama 3.1 70B) for text synthesis
USE_ISAAC_SIM=false         # Phase 3: Isaac Sim physics simulation
USE_ISAAC_LAB=false         # Phase 4: Isaac Lab GPU-accelerated RL training
USE_ISAAC_SIM_RTX=false     # Phase 5: Isaac Sim RTX 4K video rendering
USE_LEAPP_EXPORT=false      # Phase 6: LEAPP ONNX export from Isaac Lab checkpoints
USE_ISAAC_ROS=false         # Phase 7: Isaac ROS DNN inference deployment packages
USE_OSMO=false              # Phase 8: OSMO orchestration (multi-node job scheduling)

# NVIDIA API access (shared across phases)
NVIDIA_API_KEY=""
NVIDIA_API_BASE="https://api.nvidia.com"

# Cosmos Reasoner NIM (Phase 1)
COSMOS_NIM_ENDPOINT="https://api.nvidia.com/v1/cosmos/reasoner"

# NIM LLM endpoint (Phase 2)
NIM_LLM_ENDPOINT="https://api.nvidia.com/v1/nim/llama-3-70b"

# Isaac Sim REST API (Phase 3 + Phase 5)
ISAAC_SIM_ENDPOINT="http://localhost:8211"

# Isaac Lab REST API (Phase 4 + Phase 6)
ISAAC_LAB_ENDPOINT="http://localhost:8212"

# OSMO orchestration endpoint (Phase 8)
OSMO_ENDPOINT="https://api.nvidia.com/v1/osmo"

